# gh-sweep policy example
# Copy to .gh-sweep-policy.yaml and run `gh-sweep policy --list` to see drift,
# or `gh-sweep policy --apply` to sync repos toward it.
#
# Every field is optional. An omitted field is left unmanaged: gh-sweep never
# reports or changes a setting you haven't declared here.

default_org: your-org

repositories:
  - owner/repo1
  - owner/repo2
  - repo3 # uses default_org

# Repository settings (PATCH /repos/{owner}/{repo})
settings:
  delete_branch_on_merge: true
  allow_squash_merge: true
  allow_merge_commit: false
  allow_rebase_merge: false
  allow_auto_merge: false
  allow_update_branch: true
  use_squash_pr_title_as_default: true
  has_wiki: false
  has_projects: false
  # has_issues: true
  # has_discussions: false
  # allow_forking: true
  # web_commit_signoff_required: false

# security_and_analysis toggles: "enabled" or "disabled"
security:
  secret_scanning: enabled
  secret_scanning_push_protection: enabled
  # dependabot_security_updates: enabled

# Release immutability (PUT/DELETE /repos/{owner}/{repo}/immutable-releases)
releases:
  immutable: true

# Branch-protection baseline applied to each repo's default branch
# (PUT /repos/{owner}/{repo}/branches/{branch}/protection)
protection:
  required_reviews: 1
  require_code_owner_reviews: false
  require_status_checks:
    - ci
  enforce_admins: false
  require_linear_history: false
  allow_force_pushes: false
  allow_deletions: false

# A repository ruleset, managed by name (GET/POST/PUT /repos/{owner}/{repo}/rulesets).
# Rulesets sit alongside branch protection rather than replacing it, and express
# rules protection cannot: a `pull_request` block with `required_approvals: 0`
# requires a PR without requiring an approval on it. Rules and bypass actors
# gh-sweep does not model are preserved when it updates an existing ruleset.
ruleset:
  name: main
  enforcement: active # active | evaluate | disabled
  include_refs: ["~DEFAULT_BRANCH"]
  block_deletion: true
  block_force_push: true
  # require_linear_history: false
  # require_status_checks:
  #   - ci
  pull_request:
    required_approvals: 0
    require_code_owner_review: false
    allowed_merge_methods: [squash]
    # require_last_push_approval: false
    # dismiss_stale_reviews_on_push: false
    # required_review_thread_resolution: false

# Branch hygiene as desired state. `gh sweep policy --list` reports these like
# any other drift; deleting them additionally requires `--prune`, so a
# settings-only automation cannot start removing refs because this block
# appeared in the file.
branches:
  # Branches from merged or closed PRs carry no grace period: the PR records
  # the work and GitHub restores the branch from it on request.
  prune_merged: true
  prune_closed: true

  # A branch with no PR has no such record, so it waits out the grace period.
  prune_no_pr: true
  no_pr_grace_days: 21

  exclude_patterns: [gh-pages]

# Per-repo deviations from everything declared above. An unset field within a
# domain keeps the base policy's value for that repo; a set field replaces it.
# Ruleset is the exception: declaring a name here replaces the whole base
# ruleset for this repo, since a ruleset is matched by name as one unit.
overrides:
  repo3:
    protection:
      required_reviews: 0 # this repo has one maintainer
