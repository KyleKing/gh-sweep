# gh-sweep configuration example
# Copy this file to .gh-sweep.yaml in your project root or home directory
# (project file takes precedence over the home file)
#
# This file holds flag defaults. To declare the settings you want repos to
# converge on, see .gh-sweep-policy.yaml.example instead.

# Baseline repository for protection/settings comparisons (optional)
# baseline: owner/baseline-repo

# Default GitHub organization (optional)
default_org: your-org

# Repositories to manage
# Can be specified as "owner/repo" or just "repo" if default_org is set
repositories:
  - owner/repo1
  - owner/repo2
  - repo3  # Uses default_org

# Cache settings
cache:
  # Cache time-to-live (e.g., 1h, 30m, 1d)
  ttl: 1h

  # Cache directory path (default: ~/.cache/gh-sweep)
  # path: /home/you/.cache/gh-sweep

# GitHub API settings
github:
  # Personal access token (optional - will use gh CLI if available)
  # token: ghp_your_token_here

  # API base URL (for GitHub Enterprise)
  # api_url: https://github.company.com/api/v3

# Filters
filters:
  # Exclude bot users from comment search
  exclude_users:
    - dependabot[bot]
    - renovate[bot]
    - github-actions[bot]

  # Exclude repositories from operations
  exclude_repos:
    - owner/archived-repo

# Branch management settings
branches:
  # Default branch (usually main or master)
  default_branch: main

  # Protected branch patterns (won't be deleted)
  protected_patterns:
    - main
    - master
    - develop
    - release/*

# Comment review settings
comments:
  # Default lookback period for comments
  default_since_days: 30

  # Fuzzy search similarity threshold (0.0-1.0)
  fuzzy_threshold: 0.7

# GitHub Actions performance analysis settings
gha_perf:
  # Lookback period in days
  default_lookback_days: 30

  # Base branch for comparisons
  base_branch: main

  # Workflows to analyze by default (empty means all)
  default_workflows: []

  # Cache directory for run data (default: ~/.cache/gh-sweep/gha-perf)
  # cache_path: /home/you/.cache/gh-sweep/gha-perf

  # Percent slowdown flagged as a regression
  regression_threshold: 20.0

# Orphan branch detection settings
orphans:
  # Days of inactivity before a branch without a PR is considered stale
  stale_days_threshold: 30

  # Spare any branch touched within this many days, whatever its orphan type.
  # stale_days_threshold only classifies branches with no PR at all, so it
  # alone still offers a branch merged yesterday for deletion.
  min_age_days: 0

  # Branch patterns never treated as orphans
  exclude_patterns:
    - main
    - master
    - develop
    - release/*
    - hotfix/*

  # Number of repositories scanned concurrently
  default_concurrency: 5

# GitHub Pages domain audit settings
pages:
  # DNS-configured subdomains to reverse-check: each should have a live
  # Pages site backing it
  domains:
    - docs.example.com

# UI preferences
ui:
  # Color scheme: auto, light, dark
  theme: auto

  # Show icons (requires Nerd Font)
  icons: true

  # Compact mode (less padding)
  compact: false
